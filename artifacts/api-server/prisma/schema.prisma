generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model User {
  id           Int      @id @default(autoincrement())
  username     String   @unique
  passwordHash String
  role         String   @default("admin")
  createdAt    DateTime @default(now())
}

model Shop {
  id          Int          @id @default(autoincrement())
  shopId      String       @unique
  shopName    String
  ownerName   String
  mobile      String
  address     String
  createdAt   DateTime     @default(now())
  collections Collection[]
}

model Setting {
  id         Int   @id @default(autoincrement())
  pricePerKg Float @default(12)
}

model Collection {
  id             Int      @id @default(autoincrement())
  shopId         Int
  shop           Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)
  collectionDate String
  weightKg       Float
  ratePerKg      Float
  totalAmount    Float
  paymentStatus  String   @default("PENDING")
  paymentDate    String?
  paidBy         String?
  createdAt      DateTime @default(now())
}
